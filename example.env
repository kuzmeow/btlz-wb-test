# Postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# APP
APP_PORT=5000

# WB
WB_BASE_URL="https://common-api.wildberries.ru"
WB_API_KEY="your_api_key"

# SpreadSheets
SHEET_NAME=stocks_coefs

# Cron
# Формат Cron выражений
# * * * * * *
# │ │ │ │ │ │
# │ │ │ │ │ └─ День недели (0 - 7) (0 и 7 = воскресенье)
# │ │ │ │ └─── Месяц (1 - 12)
# │ │ │ └───── День месяца (1 - 31)
# │ │ └─────── Час (0 - 23)
# │ └───────── Минута (0 - 59)
# └─────────── Секунда (0 - 59)
CRON_UPDATE_TARIFFS="*/10 * * * * *"